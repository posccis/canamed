# Copie para .env e preencha os valores localmente.
# NUNCA versione o arquivo .env nem coloque credenciais reais aqui.

# ---------- Backend (ASP.NET Core lê variáveis de ambiente diretamente) ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Duplo underscore representa ":" em chaves hierárquicas do .NET.
ConnectionStrings__Canamed=Host=localhost;Port=5432;Database=canamed_dev;Username=canamed_app;Password=defina-localmente

# ---------- Frontend (Vite expõe apenas variáveis com prefixo VITE_) ----------
VITE_API_BASE_URL=http://localhost:5080/api/v1

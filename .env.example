# Copie para .env e preencha os valores localmente.
# NUNCA versione o arquivo .env nem coloque credenciais reais aqui.

# ---------- Backend (ASP.NET Core lê variáveis de ambiente diretamente) ----------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080

# Duplo underscore representa ":" em chaves hierárquicas do .NET.
ConnectionStrings__Canamed=Host=localhost;Port=5432;Database=canamed_dev;Username=canamed_app;Password=defina-localmente

# ---------- Frontend (Vite expõe apenas variáveis com prefixo VITE_) ----------
VITE_API_BASE_URL=http://localhost:5080/api/v1

# ---------- Primeiro usuário gestor (apenas Development, SPEC-0003) ----------
# Usados uma única vez, quando o banco ainda não tem nenhum usuário. Nunca versione a senha real:
# ela fica somente no .env local. A senha deve ter pelo menos 12 caracteres.
Canamed__Development__SeedUserEmail=gestor@canamed.local
Canamed__Development__SeedUserPassword=defina-localmente-senha-forte

# ---------- Conveniência de desenvolvimento (ADR-0010, opcional) ----------
# Habilita identidade por cabeçalho X-Canamed-* SOMENTE em Development/Testing, para scripts e testes
# manuais sem login. Em produção não tem efeito.
# Canamed__Development__TrustActorHeaders=true

# ---------- Suspensão temporária do segundo fator (apenas Development/Testing) ----------
# Defina como false APENAS para testar localmente sem cadastrar o autenticador. Fora de DEV/TEST o valor
# é ignorado: o gestor sempre exige verificação em duas etapas. Remova a linha para restaurar.
# Canamed__Security__RequireMfaForManagers=true
